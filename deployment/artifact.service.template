[Unit]
Description=Artifact host @KIND@
After=network.target

[Service]
WorkingDirectory=@RELEASE@
Environment=ARTIFACT_DATA=@DATA@
Environment=PUBLIC_URL=@PUBLIC@
ExecStart=@VENV@/bin/gunicorn --config deployment/gunicorn.conf.py --bind 127.0.0.1:@PORT@ artifact_host.app:@KIND@_app
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@DATA@
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=32
MemoryMax=@MEMORY@

[Install]
WantedBy=default.target
