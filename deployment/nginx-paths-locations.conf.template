# Include inside the existing @HOST@ HTTPS server. Preserve the /a prefix.
    location = /a {
        access_log off;
        error_log /dev/null;
        add_header Cache-Control "no-store" always;
        return 308 /a/;
    }
    location @read_rate_limited {
        access_log off;
        error_log /dev/null;
        default_type application/json;
        add_header Retry-After 12 always;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        return 429 '{"error":"Too many password attempts"}';
    }
    location ^~ /a/ {
        client_max_body_size 2k;
        client_body_timeout 10s;
        limit_req_status 429;
        error_page 429 = @read_rate_limited;
        access_log off;
        error_log /dev/null;
        limit_req zone=artifact_unlock burst=5 nodelay;
        # Bounded migration of old remembered cookies may emit several Set-Cookie fields.
        proxy_buffer_size 32k;
        proxy_buffers 4 32k;
        proxy_busy_buffers_size 64k;
        proxy_pass http://127.0.0.1:8792;
        proxy_set_header Host @HOST@;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_cache off;
        proxy_hide_header X-Powered-By;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
    }
    location @mcp_rate_limited {
        access_log off;
        error_log /dev/null;
        default_type application/json;
        add_header Retry-After 1 always;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        return 429 '{"error":"Too many MCP requests"}';
    }
    location = /mcp {
        limit_req_status 429;
        error_page 429 = @mcp_rate_limited;
        access_log off;
        error_log /dev/null;
        client_max_body_size 8m;
        client_body_timeout 15s;
        limit_req zone=artifact_mcp_ip burst=30 nodelay;
        limit_req zone=artifact_mcp_total burst=120 nodelay;
        proxy_pass http://127.0.0.1:8793;
        proxy_http_version 1.1;
        proxy_set_header Host @HOST@;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_connect_timeout 3s;
        proxy_read_timeout 125s;
        proxy_send_timeout 30s;
    }
