# Include inside nginx's http {}. Replace @...@ placeholders before nginx -t.
# Use separate hostnames; keep admin/API on Tailnet. No direct filesystem alias.
limit_req_zone $binary_remote_addr zone=artifact_mcp_ip:1m rate=60r/m;
limit_req_zone $server_name zone=artifact_mcp_total:1m rate=300r/m;
map $request_method $artifact_unlock_key { default ""; POST $binary_remote_addr; }
limit_req_zone $artifact_unlock_key zone=artifact_unlock:1m rate=5r/m;

server {
    listen 443 ssl;
    server_name @READ_HOST@;
    ssl_certificate @CERTIFICATE@;
    ssl_certificate_key @CERTIFICATE_KEY@;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    # Standard error logs can contain share paths. Use private operational metrics.
    error_log /dev/null;
    client_max_body_size 2k;
    client_body_timeout 10s;
    limit_req_status 429;
    error_page 429 = @read_rate_limited;
    location @read_rate_limited {
        default_type application/json;
        add_header Retry-After 12 always;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        return 429 '{"error":"Too many password attempts"}';
    }
    location / {
        limit_req zone=artifact_unlock burst=5 nodelay;
        # Bounded migration of old remembered cookies may emit several Set-Cookie fields.
        proxy_buffer_size 32k;
        proxy_buffers 4 32k;
        proxy_busy_buffers_size 64k;
        proxy_pass http://127.0.0.1:8792;
        proxy_redirect default;
        proxy_redirect http://@READ_HOST@/ https://@READ_HOST@/;
        proxy_set_header Host @READ_HOST@;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_cache off;
        proxy_hide_header X-Powered-By;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
    }
}
server {
    listen 443 ssl;
    server_name @MCP_HOST@;
    ssl_certificate @CERTIFICATE@;
    ssl_certificate_key @CERTIFICATE_KEY@;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /dev/null;
    limit_req_status 429;
    error_page 429 = @mcp_rate_limited;
    location @mcp_rate_limited {
        default_type application/json;
        add_header Retry-After 1 always;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        return 429 '{"error":"Too many MCP requests"}';
    }
    client_max_body_size 8m;
    client_body_timeout 15s;
    location = /mcp {
        limit_req zone=artifact_mcp_ip burst=30 nodelay;
        limit_req zone=artifact_mcp_total burst=120 nodelay;
        proxy_pass http://127.0.0.1:8793;
        proxy_http_version 1.1;
        proxy_set_header Host @MCP_HOST@;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_connect_timeout 3s;
        proxy_read_timeout 125s;
        proxy_send_timeout 30s;
    }
    location / { return 404; }
}
