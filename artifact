#!/usr/bin/env python3
"""Upload or revoke artifacts using a dedicated agent bearer token."""
import argparse
from pathlib import Path
from urllib.parse import quote
from artifact_host.client import api, upload, read_upload, ClientError

parser = argparse.ArgumentParser()
parser.add_argument('path', nargs='?', help='File or bundle directory to upload')
parser.add_argument('--api', help='HTTPS API origin, or loopback HTTP through SSH')
parser.add_argument('--slug', default='')
parser.add_argument('--expires', type=float, help='Expiry Unix timestamp')
parser.add_argument('--revoke', metavar='ARTIFACT_ID', help='Revoke and delete an owned artifact')
args = parser.parse_args()
if bool(args.path) == bool(args.revoke):
    parser.error('Supply a path or --revoke ARTIFACT_ID')
try:
    if args.revoke:
        api('DELETE', '/api/artifacts/' + quote(args.revoke, safe=''), endpoint=args.api)
        print('Artifact revoked')
    else:
        content, bundle = read_upload(args.path)
        print(upload(Path(args.path).name, content, args.slug, bundle, args.expires, args.api)['url'])
except (ClientError, OSError):
    parser.exit(1, 'Artifact operation failed. Check the token, endpoint, input, and server limits.\n')
